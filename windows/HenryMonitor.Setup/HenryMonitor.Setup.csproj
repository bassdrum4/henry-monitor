<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HenryMonitorSetup</AssemblyName>
    <RootNamespace>HenryMonitor.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/henry-monitor.ico</ApplicationIcon>
    <Version>1.3.2</Version>
    <Product>Henry System Monitor Setup</Product>
    <Company>Daniel Lowe</Company>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload/HenryMonitor.exe" LogicalName="Payload.HenryMonitor.exe" />
    <EmbeddedResource Include="Payload/HenryPhotos.exe" LogicalName="Payload.HenryPhotos.exe" />
    <EmbeddedResource Include="Payload/HenryMonitor.apk" LogicalName="Payload.HenryMonitor.apk" />
    <EmbeddedResource Include="Payload/adb.exe" LogicalName="Payload.adb.exe" />
    <EmbeddedResource Include="Payload/AdbWinApi.dll" LogicalName="Payload.AdbWinApi.dll" />
    <EmbeddedResource Include="Payload/AdbWinUsbApi.dll" LogicalName="Payload.AdbWinUsbApi.dll" />
    <EmbeddedResource Include="Payload/PawnIO_setup.exe" LogicalName="Payload.PawnIO_setup.exe" />
    <EmbeddedResource Include="../../THIRD_PARTY_NOTICES.txt" LogicalName="Payload.THIRD_PARTY_NOTICES.txt" />
    <EmbeddedResource Include="../../README.md" LogicalName="Payload.USER_GUIDE.md" />
  </ItemGroup>
</Project>
