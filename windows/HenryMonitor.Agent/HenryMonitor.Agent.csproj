<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HenryMonitor</AssemblyName>
    <RootNamespace>HenryMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/henry-monitor.ico</ApplicationIcon>
    <Version>1.3.7</Version>
    <Product>Henry System Monitor</Product>
    <Company>Daniel Lowe</Company>
    <Description>Private local PC telemetry and control companion for Henry System Monitor.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!-- Newer hardware support than the 2024 stable build, including current
         AMD/Intel platforms that otherwise report only generic memory data. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre733" />
  </ItemGroup>
</Project>
